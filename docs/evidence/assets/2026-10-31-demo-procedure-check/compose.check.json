{
  "services": {
    "app": {
      "image": "ns7jp-demo-check:20261031",
      "build": {
        "context": "/workspace/server",
        "dockerfile": "/tmp/ns7jp-demo-check-20261031/Dockerfile",
        "secrets": [
          "proxy_ca"
        ]
      }
    },
    "prometheus": {
      "volumes": [
        "/tmp/ns7jp-demo-check-20261031/prometheus.yml:/etc/prometheus/prometheus.yml:ro",
        "/tmp/ns7jp-demo-check-20261031/rules.yml:/etc/prometheus/rules.yml:ro",
        "/tmp/ns7jp-demo-check-20261031/slo-rules.yml:/etc/prometheus/slo-rules.yml:ro"
